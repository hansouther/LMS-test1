diff --git a/backend/routes_chat.py b/backend/routes_chat.py
new file mode 100644
index 0000000..3b67a3a
--- /dev/null
+++ b/backend/routes_chat.py
@@ -0,0 +1,136 @@
+import uuid
+import asyncio
+from fastapi import APIRouter, HTTPException, Depends, UploadFile, File
+from pydantic import BaseModel
+from typing import Optional
+
+from database import db
+from utils import new_id, now_iso
+from security import require_roles
+from storage import put_object, APP_NAME
+
+router = APIRouter(prefix="/api", tags=["chat"])
+student_only = require_roles("student")
+admin_only = require_roles("admin")
+chat_user = require_roles("student", "admin")
+
+IMG_EXT = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp"}
+MAX_TEXT = 2000
+
+
+class MessageBody(BaseModel):
+    text: Optional[str] = ""
+    image_url: Optional[str] = None
+
+
+def _clean(body: MessageBody):
+    text = (body.text or "").strip()[:MAX_TEXT]
+    img = body.image_url if body.image_url and body.image_url.startswith("/api/files/") else None
+    if not text and not img:
+        raise HTTPException(status_code=400, detail="Pesan kosong")
+    return text, img
+
+
+async def _messages(student_id: str, after: Optional[str]):
+    q = {"thread_id": student_id}
+    if after:
+        q["created_at"] = {"$gt": after}
+    items = await db.chat_messages.find(q, {"_id": 0}).sort("created_at", -1).to_list(200)
+    return items[::-1]
+
+
+async def _post(student_id: str, sender: dict, text: str, img: Optional[str]) -> dict:
+    msg = {"id": new_id(), "thread_id": student_id, "sender_id": sender["id"], "sender_role": sender["role"],
+           "sender_name": sender.get("name"), "text": text, "image_url": img, "created_at": now_iso()}
+    await db.chat_messages.insert_one(msg)
+    inc = "unread_admin" if sender["role"] == "student" else "unread_student"
+    await db.chat_threads.update_one(
+        {"id": student_id},
+        {"$set": {"id": student_id, "student_id": student_id, "last_text": text or "[Gambar]",
+                  "last_role": sender["role"], "last_at": msg["created_at"]}, "$inc": {inc: 1}},
+        upsert=True,
+    )
+    msg.pop("_id", None)
+    return msg
+
+
+@router.post("/chat/upload")
+async def chat_upload(file: UploadFile = File(...), user: dict = Depends(chat_user)):
+    ext = file.filename.rsplit(".", 1)[-1].lower() if "." in (file.filename or "") else ""
+    if ext not in IMG_EXT:
+        raise HTTPException(status_code=400, detail="Format gambar harus PNG, JPG, atau WEBP")
+    data = await file.read()
+    if len(data) > 5 * 1024 * 1024:
+        raise HTTPException(status_code=400, detail="Ukuran gambar maksimal 5 MB")
+    path = f"{APP_NAME}/chat/{user['id']}/{uuid.uuid4().hex}.{ext}"
+    try:
+        result = await asyncio.to_thread(put_object, path, data, IMG_EXT[ext])
+    except Exception as e:
+        raise HTTPException(status_code=502, detail=f"Gagal mengunggah gambar: {e}")
+    await db.files.insert_one({
+        "id": uuid.uuid4().hex, "storage_path": result["path"], "original_filename": file.filename,
+        "content_type": IMG_EXT[ext], "size": len(data), "uploaded_by": user["id"],
+        "is_deleted": False, "created_at": now_iso(),
+    })
+    return {"url": f"/api/files/{result['path']}"}
+
+
+# ----- Siswa -----
+@router.get("/chat/messages")
+async def my_messages(after: Optional[str] = None, user: dict = Depends(student_only)):
+    return await _messages(user["id"], after)
+
+
+@router.post("/chat/messages")
+async def send_my_message(body: MessageBody, user: dict = Depends(student_only)):
+    text, img = _clean(body)
+    return await _post(user["id"], user, text, img)
+
+
+@router.get("/chat/unread")
+async def my_unread(user: dict = Depends(student_only)):
+    t = await db.chat_threads.find_one({"id": user["id"]}, {"_id": 0, "unread_student": 1})
+    return {"count": (t or {}).get("unread_student", 0)}
+
+
+@router.post("/chat/read")
+async def my_read(user: dict = Depends(student_only)):
+    await db.chat_threads.update_one({"id": user["id"]}, {"$set": {"unread_student": 0}})
+    return {"ok": True}
+
+
+# ----- Admin -----
+@router.get("/admin/chat/unread")
+async def admin_unread(user: dict = Depends(admin_only)):
+    rows = await db.chat_threads.aggregate([{"$group": {"_id": None, "n": {"$sum": "$unread_admin"}}}]).to_list(1)
+    return {"count": rows[0]["n"] if rows else 0}
+
+
+@router.get("/admin/chat/threads")
+async def admin_threads(user: dict = Depends(admin_only)):
+    threads = await db.chat_threads.find({}, {"_id": 0}).sort("last_at", -1).to_list(500)
+    sids = [t["student_id"] for t in threads]
+    users = await db.users.find({"id": {"$in": sids}}, {"_id": 0, "id": 1, "name": 1, "email": 1, "grade": 1, "school_id": 1, "picture": 1}).to_list(500)
+    umap = {u["id"]: u for u in users}
+    smap = {s["id"]: s["name"] for s in await db.schools.find({}, {"_id": 0, "id": 1, "name": 1}).to_list(500)}
+    out = []
+    for t in threads:
+        u = umap.get(t["student_id"]) or {}
+        out.append({**t, "student_name": u.get("name") or "(akun dihapus)", "student_email": u.get("email"),
+                    "grade": u.get("grade"), "school_name": smap.get(u.get("school_id")), "picture": u.get("picture"),
+                    "unread_admin": t.get("unread_admin", 0)})
+    return out
+
+
+@router.get("/admin/chat/threads/{student_id}/messages")
+async def admin_thread_messages(student_id: str, after: Optional[str] = None, user: dict = Depends(admin_only)):
+    await db.chat_threads.update_one({"id": student_id}, {"$set": {"unread_admin": 0}})
+    return await _messages(student_id, after)
+
+
+@router.post("/admin/chat/threads/{student_id}/messages")
+async def admin_send(student_id: str, body: MessageBody, user: dict = Depends(admin_only)):
+    if not await db.users.find_one({"id": student_id, "role": "student"}, {"_id": 1}):
+        raise HTTPException(status_code=404, detail="Siswa tidak ditemukan")
+    text, img = _clean(body)
+    return await _post(student_id, user, text, img)
diff --git a/backend/routes_school_classes.py b/backend/routes_school_classes.py
new file mode 100644
index 0000000..ced7475
--- /dev/null
+++ b/backend/routes_school_classes.py
@@ -0,0 +1,152 @@
+import re
+from fastapi import APIRouter, HTTPException, Depends
+from fastapi.responses import Response
+from pydantic import BaseModel
+from typing import List, Optional
+
+from database import db
+from utils import new_id, now_iso
+from security import require_roles
+import analysis
+
+router = APIRouter(prefix="/api", tags=["school-classes"])
+admin_only = require_roles("admin")
+
+LEVELS = {"SD": "SD / Sederajat", "SMP": "SMP / Sederajat", "SMA": "SMA / Sederajat"}
+LEVEL_ORDER = {"SD": 0, "SMP": 1, "SMA": 2}
+
+
+def _norm(s: str) -> str:
+    return re.sub(r"\s+", " ", (s or "").strip()).upper()
+
+
+def _sort_key(c):
+    parts = re.split(r"(\d+)", c["label"])
+    return (LEVEL_ORDER.get(c["level"], 9), [int(p) if p.isdigit() else p for p in parts])
+
+
+async def classes_of(school_id: str) -> list:
+    items = await db.school_classes.find({"school_id": school_id}, {"_id": 0}).to_list(500)
+    return sorted(items, key=_sort_key)
+
+
+async def annotate(user: dict) -> dict:
+    """Tandai siswa yang kelasnya belum sesuai daftar kelas resmi sekolahnya."""
+    if not user or user.get("role") != "student":
+        return user
+    need = False
+    sid = user.get("school_id")
+    if sid and await db.school_classes.count_documents({"school_id": sid}):
+        cid = user.get("class_id")
+        need = not cid or not await db.school_classes.find_one({"id": cid, "school_id": sid}, {"_id": 1})
+    user["needs_class"] = need
+    return user
+
+
+async def resolve_class(school_id: Optional[str], class_id: Optional[str], grade: Optional[str], level: Optional[str]) -> dict:
+    """Validasi pilihan kelas siswa -> field yang disimpan (grade = label kelas resmi)."""
+    if class_id:
+        c = await db.school_classes.find_one({"id": class_id}, {"_id": 0})
+        if not c or (school_id and c["school_id"] != school_id):
+            raise HTTPException(status_code=400, detail="Kelas tidak ditemukan untuk sekolah ini")
+        return {"class_id": c["id"], "grade": c["label"], "level": c["level"]}
+    if school_id and await db.school_classes.count_documents({"school_id": school_id}):
+        raise HTTPException(status_code=400, detail="Pilih jenjang dan kelas dari daftar yang ditentukan admin")
+    out = {"class_id": None}
+    if grade is not None:
+        out["grade"] = grade.strip()
+    if level in LEVELS:
+        out["level"] = level
+    return out
+
+
+@router.get("/public/schools/{school_id}/classes")
+async def public_classes(school_id: str):
+    return [{"id": c["id"], "level": c["level"], "label": c["label"]} for c in await classes_of(school_id)]
+
+
+@router.get("/admin/schools/{school_id}/classes")
+async def admin_classes(school_id: str, user: dict = Depends(admin_only)):
+    items = await classes_of(school_id)
+    for c in items:
+        c["student_count"] = await db.users.count_documents({"role": "student", "class_id": c["id"]})
+    mismatch = 0
+    if items:
+        ids = [c["id"] for c in items]
+        mismatch = await db.users.count_documents({"role": "student", "school_id": school_id, "class_id": {"$nin": ids}})
+    return {"items": items, "mismatch": mismatch}
+
+
+class ClassBulkBody(BaseModel):
+    level: str
+    labels: List[str]
+
+
+@router.post("/admin/schools/{school_id}/classes")
+async def create_classes(school_id: str, body: ClassBulkBody, user: dict = Depends(admin_only)):
+    if body.level not in LEVELS:
+        raise HTTPException(status_code=400, detail="Jenjang tidak valid")
+    if not await db.schools.find_one({"id": school_id}, {"_id": 1}):
+        raise HTTPException(status_code=404, detail="Sekolah tidak ditemukan")
+    existing = {_norm(c["label"]) for c in await classes_of(school_id)}
+    docs = []
+    for raw in body.labels[:100]:
+        label = _norm(raw)
+        if not label or label in existing:
+            continue
+        existing.add(label)
+        docs.append({"id": new_id(), "school_id": school_id, "level": body.level, "label": label, "created_at": now_iso()})
+    if docs:
+        await db.school_classes.insert_many(docs)
+    return {"created": len(docs), "skipped": len(body.labels) - len(docs)}
+
+
+class ClassUpdateBody(BaseModel):
+    label: str
+    level: str
+
+
+@router.put("/admin/school-classes/{class_id}")
+async def update_class(class_id: str, body: ClassUpdateBody, user: dict = Depends(admin_only)):
+    c = await db.school_classes.find_one({"id": class_id}, {"_id": 0})
+    if not c:
+        raise HTTPException(status_code=404, detail="Kelas tidak ditemukan")
+    label = _norm(body.label)
+    if not label or body.level not in LEVELS:
+        raise HTTPException(status_code=400, detail="Nama kelas / jenjang tidak valid")
+    dup = await db.school_classes.find_one({"school_id": c["school_id"], "label": label, "id": {"$ne": class_id}}, {"_id": 1})
+    if dup:
+        raise HTTPException(status_code=400, detail="Nama kelas sudah ada di sekolah ini")
+    await db.school_classes.update_one({"id": class_id}, {"$set": {"label": label, "level": body.level}})
+    await db.users.update_many({"class_id": class_id}, {"$set": {"grade": label, "level": body.level}})
+    return {"ok": True}
+
+
+@router.delete("/admin/school-classes/{class_id}")
+async def delete_class(class_id: str, user: dict = Depends(admin_only)):
+    await db.school_classes.delete_one({"id": class_id})
+    return {"ok": True}
+
+
+async def _class_or_404(class_id: str) -> dict:
+    c = await db.school_classes.find_one({"id": class_id}, {"_id": 0})
+    if not c:
+        raise HTTPException(status_code=404, detail="Kelas tidak ditemukan")
+    return c
+
+
+@router.get("/admin/school-classes/{class_id}/students")
+async def class_students(class_id: str, user: dict = Depends(admin_only)):
+    await _class_or_404(class_id)
+    return await db.users.find({"role": "student", "class_id": class_id},
+                               {"_id": 0, "id": 1, "name": 1, "email": 1, "phone": 1}).sort("name", 1).to_list(1000)
+
+
+@router.get("/admin/school-classes/{class_id}/scores.csv")
+async def class_scores_csv(class_id: str, user: dict = Depends(admin_only)):
+    c = await _class_or_404(class_id)
+    ids = [u["id"] for u in await db.users.find({"role": "student", "class_id": class_id}, {"_id": 0, "id": 1}).to_list(1000)]
+    rep = await analysis.build_report(ids)
+    name = re.sub(r"[^A-Za-z0-9_-]+", "_", c["label"])
+    return Response(content=analysis.scores_csv(rep), media_type="text/csv",
+                    headers={"Content-Disposition": f"attachment; filename=nilai_kelas_{name}.csv"})
